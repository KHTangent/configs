{
	"$schema": "https://opencode.ai/v2/cli.json",
	"diffs": {
		"wrap": "word",
		"view": "auto"
	},
	"session": {
		"sidebar": "auto",
		"scrollbar": false,
		"thinking": "hide",
		"permissions": "prompt"
	},
	"animations": true,
	"theme": {
		"name": "dracula",
		"mode": "system"
	},
	"tabs": {
		"layout": "horizontal"
	},
	"terminal": {
		"copy": "select"
	}
}
